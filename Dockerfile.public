FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip install --break-system-packages 'websockets>=12,<16'

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY server.py import_site.py pi_edit_adapter.mjs ./
COPY dist/ ./dist/
COPY assets/ ./assets/

USER node
ENV HTTP_PORT=8800 AUDIO_PORT=8801 CALLIOPE_PUBLIC_MODE=1 CALLIOPE_REVIEW_MODE=1
EXPOSE 8800 8801
CMD ["python3", "server.py"]

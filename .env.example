# Copy this file to .env. With auto selection, Anthropic wins if both keys are set.
# Never commit .env.
RESON8_API_KEY=
ANTHROPIC_API_KEY=
LYCEUM_API_KEY=
# Only used with Lyceum. Claude uses the fastest Haiku model.
MODEL=deepseek/deepseek-v4-flash-0731
# auto selects Anthropic then Lyceum. Set openrouter to use gpt-oss-120b on Cerebras only.
AGENT_PROVIDER=auto
OPENROUTER_API_KEY=

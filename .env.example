# Copy this file to .env and fill in the keys. Never commit .env.
RESON8_API_KEY=your-res...n
# Confirm the exact model id in the Anthropic console at setup time.
# ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-5
# Optional: use OpenRouter for APPLY instead of Anthropic. Set the key in your local .env.
# AGENT_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=x-ai/grok-4.20

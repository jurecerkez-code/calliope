# Copy this file to .env. With auto selection, Anthropic wins if both keys are set.
# Never commit .env.
RESON8_API_KEY=
ANTHROPIC_API_KEY=
# Claude is the agent brain. Confirm the exact model id in the Anthropic console.
MODEL=claude-haiku-5-5
# auto selects Anthropic (Claude) first. Set openrouter to use gpt-oss-120b on Cerebras only.
AGENT_PROVIDER=auto
OPENROUTER_API_KEY=

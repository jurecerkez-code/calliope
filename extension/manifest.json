{
	"manifest_version": 3,
	"name": "Draw and Talk",
	"version": "0.1.0",
	"description": "Draw on any page while you speak. Get a timestamped context packet a coding agent can act on.",
	"minimum_chrome_version": "116",
	"action": {
		"default_title": "Draw and Talk: open panel and enable drawing on this tab"
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"side_panel": {
		"default_path": "sidepanel/panel.html"
	},
	"options_page": "options/options.html",
	"permissions": ["activeTab", "scripting", "sidePanel", "storage"],
	"host_permissions": ["https://api.reson8.dev/*"],
	"optional_host_permissions": ["http://*/*", "https://*/*"],
	"commands": {
		"toggle-draw": {
			"suggested_key": { "default": "Alt+Shift+D" },
			"description": "Toggle drawing on the current tab"
		},
		"toggle-voice": {
			"suggested_key": { "default": "Alt+Shift+V" },
			"description": "Start or stop live voice"
		},
		"copy-packet": {
			"suggested_key": { "default": "Alt+Shift+C" },
			"description": "Copy the context packet"
		}
	},
	"web_accessible_resources": [
		{
			"resources": [
				"content/overlay.js",
				"content/overlay.css",
				"lib/strokes.js",
				"lib/targets.js"
			],
			"matches": ["<all_urls>"]
		}
	],
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}
